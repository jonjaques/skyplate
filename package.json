{
  "name": "skyplate",
  "version": "0.1.0",
  "description": "Point it at any project and get a static report: a 3D plate of every file, a statistics dashboard, a source reader and TypeScript code intelligence.",
  "keywords": [
    "codebase",
    "code-visualization",
    "code-map",
    "repository-analysis",
    "static-report",
    "dependency-graph",
    "git-history",
    "hotspots",
    "typescript",
    "3d",
    "cli"
  ],
  "homepage": "https://github.com/jonjaques/skyplate",
  "bugs": {
    "url": "https://github.com/jonjaques/skyplate/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Jon Jaques",
    "url": "https://github.com/jonjaques"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonjaques/skyplate.git"
  },
  "type": "module",
  "bin": {
    "skyplate": "bin/skyplate.ts"
  },
  "files": [
    "bin",
    "src/cli",
    "src/core",
    "src/mcp",
    "src/shared",
    "dist/viewer",
    "!dist/viewer/**/*.map",
    "docs/brand",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "typecheck": "bun check",
    "skyplate": "bun bin/skyplate.ts",
    "report:dev": "bun bin/skyplate.ts --out .skyplate/dev",
    "prepublishOnly": "bun run build && bun test && bun check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "d3-force-3d": "^3.0.6",
    "ignore": "^7.0.14",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@types/bun": "latest",
    "@types/d3": "^7.4.3",
    "@types/fontkit": "^2.0.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "fontkit": "^2.0.4",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.66.0",
    "postprocessing": "^6.39.5",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "react-resizable-panels": "^4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.11",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  }
}
