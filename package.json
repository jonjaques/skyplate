{
  "name": "starchart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "starchart": "bin/starchart.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "typecheck": "bun check",
    "starchart": "bun bin/starchart.ts",
    "report:dev": "bun bin/starchart.ts --out .starchart/dev"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "d3-force-3d": "^3.0.6",
    "ignore": "^7.0.14",
    "lucide-react": "^1.66.0",
    "postprocessing": "^6.39.5",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "react-resizable-panels": "^4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.11",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/d3": "^7.4.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0"
  },
  "description": "Point it at any project; get an explorable 3D galaxy map, statistics dashboard, and source reader as a static site."
}
