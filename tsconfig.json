{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun", "react"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },

  // Eval fixtures are small repositories for Skyplate to analyze, some broken on purpose (a
  // failing tsconfig, a missing package, foreign syntax), so they are inputs, not our code. The
  // TypeScript eval's oracle runs on TypeScript 5.9.3 from that eval's own package, which a clean
  // checkout does not install; against the root's TypeScript 7 its classic API does not exist.
  // `bun check evals/typescript/oracle.ts` checks it once that package is installed.
  "exclude": ["dist", "node_modules", "evals/**/fixtures", "evals/typescript/oracle.ts"]
}
